# Backend HTTP
LISTEN_ADDR=127.0.0.1:8080
LOG_LEVEL=info

# mTLS identity. Header-based identity is honored only from these peers.
IDENTITY_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# OIDC (Keycloak). OIDC_ISSUER is required: the API refuses to start
# without it rather than serving /v1/ unauthenticated.
# OIDC_JWKS_URL is optional; when empty it is derived from the issuer
# using the Keycloak convention (/protocol/openid-connect/certs).
OIDC_ISSUER=http://localhost:8081/realms/nfa
OIDC_JWKS_URL=
# Clients permitted to call this API, by azp claim. These are the
# clients declared in deploy/keycloak/realm.json.
OIDC_ALLOWED_AZP=nfa-console,nfa-mobile,nfa-service

# Local development only. nfa-test enables the ROPC grant so scripts and
# the integration suite can mint a user token without a browser. A
# deployed instance leaves this empty; the API logs a warning when it is
# not.
OIDC_ALLOWED_AZP_TEST_CLIENTS=

# Datastores
DATABASE_URL=postgres://nfa:nfa@localhost:5432/nfa?sslmode=disable
DATABASE_MAX_CONNS=25
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=tenders
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nfa
MINIO_SECRET_KEY=nfa-secret
MINIO_BUCKET=nfa-documents
REDIS_URL=redis://localhost:6379

# Feed / outbound
FEED_BASE_URL=http://localhost:9090
FEED_API_KEY=local-mock-key
WEBHOOK_SIGNING_SECRET=local-only-not-a-real-secret
SMTP_URL=smtp://localhost:1025

# Web
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Observability & limits
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=0.1
AUDIT_RETENTION_DAYS=2555
IDEMPOTENCY_TTL=24h
RATE_LIMIT_RPS=100
MAX_BODY_BYTES=1048576

# Keycloak admin (compose only)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=nfa
KEYCLOAK_URL=http://localhost:8081
NFA_OAUTH_CLIENT_ID=nfa-console
NFA_SERVICE_CLIENT_SECRET=local-service-secret-replace-in-prod
NFA_OAUTH_CLIENT_SECRET=local-service-secret-replace-in-prod
