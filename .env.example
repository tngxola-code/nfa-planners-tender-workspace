LISTEN_ADDR=:8000
LOG_LEVEL=info
DATABASE_URL=postgres://nfa:nfa@localhost:5432/nfa?sslmode=disable
DATABASE_MAX_CONNS=25
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=tenders
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nfa
MINIO_SECRET_KEY=nfa-secret
MINIO_BUCKET=nfa-documents
REDIS_URL=redis://localhost:6379
OIDC_ISSUER=http://localhost:8081/realms/nfa
OIDC_AUDIENCE=nfa-api
FEED_BASE_URL=http://localhost:9090
FEED_API_KEY=local-mock-key
WEBHOOK_SIGNING_SECRET=local-only-not-a-real-secret
SMTP_URL=smtp://localhost:1025
CORS_ALLOWED_ORIGINS=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SAMPLE_RATE=0.1
AUDIT_RETENTION_DAYS=2555
IDEMPOTENCY_TTL=24h
RATE_LIMIT_RPS=100
MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------- keycloak
# Master realm credentials. Local only. Never committed.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# The NFA realm. Imported from deploy/keycloak/realm.json.
# Client IDs are fixed constants, not environment variables:
#   nfa-console   public, Authorization Code + PKCE
#   nfa-mobile    public, Authorization Code + PKCE
#   nfa-service   confidential, Client Credentials
KEYCLOAK_REALM=nfa
KEYCLOAK_URL=http://localhost:8081
NFA_OAUTH_CLIENT_ID=nfa-console
# The service secret is in the realm file for local. In UAT and prod it
# comes from SOPS and is injected into the realm before import.
NFA_SERVICE_CLIENT_SECRET=local-service-secret-replace-in-prod
NFA_OAUTH_CLIENT_SECRET=local-service-secret-replace-in-prod

