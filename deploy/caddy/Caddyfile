# Caddy front door for the NFA planners tender workspace.
#
# Terminates TLS for the public hostname, requires a client certificate
# from a bundled CA, and forwards the verified cert's identity to the
# backend as headers. The backend MUST NOT be reachable from anywhere
# except Caddy: bind it to loopback, and rely on the identity middleware's
# TrustedProxies check as a second line of defense.

{
	admin off
}

nfa.example.com {
	tls {
		client_auth {
			# require_and_verify aborts the handshake when the client
			# presents no certificate or one that does not chain to the
			# trust pool. The `request` mode would let unverified certs
			# through, and the backend would have no way to distinguish
			# them from verified ones.
			mode require_and_verify
			trust_pool file /etc/caddy/client-ca.pem
		}
	}

	# Matcher fires when the handshake carried a verified client cert.
	@withClientCert expression {http.request.tls.client.subject} != ""

	# Always strip any inbound X-Client-Cert-* so a hostile client cannot
	# smuggle values through. Caddy renders each placeholder into its own
	# header, but stripping first costs nothing and closes the door if a
	# future Caddy version changes placeholder behavior.
	handle @withClientCert {
		reverse_proxy 127.0.0.1:8080 {
			header_up -X-Client-Cert-Subject
			header_up -X-Client-Cert-Issuer
			header_up -X-Client-Cert-Serial
			header_up -X-Client-Cert-Fingerprint

			header_up X-Client-Cert-Subject     {http.request.tls.client.subject}
			header_up X-Client-Cert-Issuer      {http.request.tls.client.issuer}
			header_up X-Client-Cert-Serial      {http.request.tls.client.serial}
			header_up X-Client-Cert-Fingerprint {http.request.tls.client.fingerprint}
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8080 {
			header_up -X-Client-Cert-Subject
			header_up -X-Client-Cert-Issuer
			header_up -X-Client-Cert-Serial
			header_up -X-Client-Cert-Fingerprint
		}
	}
}
